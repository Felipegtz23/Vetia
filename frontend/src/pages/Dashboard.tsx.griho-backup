import { useEffect, useState } from "react";
import {
  Activity,
  AlertCircle,
  CheckCircle2,
  ChevronRight,
  Database,
  HeartPulse,
  LoaderCircle,
  PawPrint,
  RefreshCw,
  Search,
  ShieldCheck,
  Stethoscope,
} from "lucide-react";

import {
  getHealth,
  getSymptoms,
  getDiseases,
  diagnose,
} from "../services/diagnosisService";

import type {
  DiagnosisResponse,
  Symptom,
  Disease,
  Hypothesis,
} from "../types/diagnosis";

type Section = "diagnostico" | "conocimiento";

export default function Dashboard() {
  const [section, setSection] = useState<Section>("diagnostico");
  const [symptoms, setSymptoms] = useState<Symptom[]>([]);
  const [diseases, setDiseases] = useState<Disease[]>([]);
  const [presentSymptoms, setPresentSymptoms] = useState<string[]>([]);
  const [absentSymptoms, setAbsentSymptoms] = useState<string[]>([]);
  const [result, setResult] = useState<DiagnosisResponse | null>(null);
  const [loading, setLoading] = useState(true);
  const [analyzing, setAnalyzing] = useState(false);
  const [error, setError] = useState("");
  const [backendStatus, setBackendStatus] = useState("Comprobando...");
  const [search, setSearch] = useState("");

  useEffect(() => {
    loadData();
  }, []);

  async function loadData() {
    setLoading(true);
    setError("");

    try {
      const [health, symptomData, diseaseData] = await Promise.all([
        getHealth(),
        getSymptoms(),
        getDiseases(),
      ]);

      setBackendStatus(
        health.prolog === "connected"
          ? "Prolog conectado"
          : "Prolog desconectado"
      );

      setSymptoms(symptomData);
      setDiseases(diseaseData);
    } catch (err) {
      setBackendStatus("Sin conexión");
      setError(
        err instanceof Error
          ? err.message
          : "No fue posible conectar con VetIA."
      );
    } finally {
      setLoading(false);
    }
  }

  function toggleSymptom(id: string, type: "present" | "absent") {
    setResult(null);
    setError("");

    if (type === "present") {
      setPresentSymptoms((previous) =>
        previous.includes(id)
          ? previous.filter((item) => item !== id)
          : [...previous, id]
      );

      setAbsentSymptoms((previous) =>
        previous.filter((item) => item !== id)
      );
    } else {
      setAbsentSymptoms((previous) =>
        previous.includes(id)
          ? previous.filter((item) => item !== id)
          : [...previous, id]
      );

      setPresentSymptoms((previous) =>
        previous.filter((item) => item !== id)
      );
    }
  }

  async function handleDiagnosis() {
    if (presentSymptoms.length === 0 && absentSymptoms.length === 0) {
      setError("Selecciona al menos un síntoma presente o ausente.");
      return;
    }

    setAnalyzing(true);
    setError("");
    setResult(null);

    try {
      const response = await diagnose(
        presentSymptoms,
        absentSymptoms
      );

      setResult(response);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "No se pudo realizar la evaluación."
      );
    } finally {
      setAnalyzing(false);
    }
  }

  function resetDiagnosis() {
    setPresentSymptoms([]);
    setAbsentSymptoms([]);
    setResult(null);
    setError("");
  }

  const systems = Array.from(
    new Set(symptoms.map((symptom) => symptom.sistema))
  );

  const filteredDiseases = diseases.filter((disease) =>
    disease.nombre.toLowerCase().includes(search.toLowerCase())
  );

  function HypothesisCard({
    hypothesis,
    index,
  }: {
    hypothesis: Hypothesis;
    index: number;
  }) {
    const percentage = Math.min(
      100,
      Math.max(0, hypothesis.porcentaje_coincidencia)
    );

    return (
      <article className="mb-5 rounded-2xl border border-[#5A3A30] bg-[#FAF8F4] p-6">
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p className="text-[9px] font-bold uppercase tracking-wider text-[#81776F]">
              HIPÓTESIS {index + 1}
            </p>

            <h3 className="mt-2 font-heading text-lg font-bold">
              {hypothesis.enfermedad.nombre}
            </h3>

            <p className="mt-1 text-xs text-[#81776F]">
              {hypothesis.enfermedad.id}
            </p>
          </div>

          <span className="rounded-full bg-[#5A3433] px-3 py-2 text-xs font-bold text-[#5A3433]">
            {hypothesis.coincidencias} coincidencias
          </span>
        </div>

        <div className="mt-5 rounded-xl bg-[#FAF8F4] p-4">
          <div className="flex items-center justify-between gap-3">
            <p className="text-xs font-bold">
              Cobertura de síntomas registrados
            </p>
            <span className="text-sm font-bold">{percentage}%</span>
          </div>

          <div className="mt-3 h-2 overflow-hidden rounded-full bg-[#5A3A30]">
            <div
              className="h-full rounded-full bg-[#5A3433]"
              style={{ width: `${percentage}%` }}
            />
          </div>

          <p className="mt-2 text-[10px] leading-5 text-[#81776F]">
            {hypothesis.interpretacion_porcentaje}
          </p>
        </div>

        <div className="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <p className="text-xs font-bold text-[#5A3433]">
              Síntomas coincidentes
            </p>

            <ul className="mt-3 space-y-2">
              {hypothesis.sintomas_coincidentes.map((symptom) => (
                <li key={symptom.id} className="text-xs text-[#81776F]">
                  • {symptom.nombre}
                </li>
              ))}

              {hypothesis.sintomas_coincidentes.length === 0 && (
                <li className="text-xs text-[#81776F]">
                  Sin coincidencias.
                </li>
              )}
            </ul>
          </div>

          <div>
            <p className="text-xs font-bold text-[#5A3433]">
              Síntomas no reportados
            </p>

            <ul className="mt-3 space-y-2">
              {hypothesis.sintomas_no_reportados.map((symptom) => (
                <li key={symptom} className="text-xs text-[#81776F]">
                  • {symptom}
                </li>
              ))}

              {hypothesis.sintomas_no_reportados.length === 0 && (
                <li className="text-xs text-[#81776F]">
                  Ninguno.
                </li>
              )}
            </ul>
          </div>

          <div>
            <p className="text-xs font-bold text-[#5A3433]">
              Síntomas orientativos
            </p>

            <ul className="mt-3 space-y-2">
              {hypothesis.sintomas_orientativos.map((symptom) => (
                <li key={symptom.id} className="text-xs text-[#81776F]">
                  • {symptom.nombre}
                </li>
              ))}

              {hypothesis.sintomas_orientativos.length === 0 && (
                <li className="text-xs text-[#81776F]">
                  Sin registros.
                </li>
              )}
            </ul>
          </div>

          <div>
            <p className="text-xs font-bold text-[#5A3433]">
              Síntomas inespecíficos
            </p>

            <ul className="mt-3 space-y-2">
              {hypothesis.sintomas_inespecificos.map((symptom) => (
                <li key={symptom.id} className="text-xs text-[#81776F]">
                  • {symptom.nombre}
                </li>
              ))}

              {hypothesis.sintomas_inespecificos.length === 0 && (
                <li className="text-xs text-[#81776F]">
                  Sin registros.
                </li>
              )}
            </ul>
          </div>
        </div>

        <div className="mt-6 border-t border-[#5A3A30] pt-5">
          <p className="text-xs font-bold text-[#5A3433]">
            Síntomas ausentes
          </p>

          <div className="mt-3 flex flex-wrap gap-2">
            {hypothesis.sintomas_ausentes.map((symptom) => (
              <span
                key={symptom}
                className="rounded-lg bg-red-50 px-3 py-2 text-[10px] text-red-700"
              >
                {symptom}
              </span>
            ))}

            {hypothesis.sintomas_ausentes.length === 0 && (
              <span className="text-xs text-[#81776F]">
                No hay síntomas ausentes asociados.
              </span>
            )}
          </div>
        </div>

        <div className="mt-6 border-t border-[#5A3A30] pt-5">
          <p className="text-xs font-bold text-[#5A3433]">
            Pruebas coincidentes
          </p>

          <div className="mt-3 flex flex-wrap gap-2">
            {hypothesis.pruebas_coincidentes.map((test) => (
              <span
                key={test}
                className="rounded-lg bg-[#5A3433] px-3 py-2 text-[10px] text-[#5A3433]"
              >
                {test}
              </span>
            ))}

            {hypothesis.pruebas_coincidentes.length === 0 && (
              <span className="text-xs text-[#81776F]">
                Sin pruebas coincidentes.
              </span>
            )}
          </div>
        </div>

        <div className="mt-6 border-t border-[#5A3A30] pt-5">
          <p className="text-xs font-bold text-[#5A3433]">
            Reglas activadas
          </p>

          {hypothesis.reglas_activadas.length > 0 ? (
            <div className="mt-3 space-y-3">
              {hypothesis.reglas_activadas.map((rule) => (
                <div
                  key={rule.id}
                  className="rounded-xl bg-[#FAF8F4] p-4"
                >
                  <p className="text-xs font-bold">{rule.id}</p>

                  <p className="mt-2 text-xs leading-5 text-[#81776F]">
                    {rule.justificacion}
                  </p>

                  <p className="mt-2 text-[10px] text-[#81776F]">
                    Fuente: {rule.fuente}
                  </p>
                </div>
              ))}
            </div>
          ) : (
            <p className="mt-2 text-xs text-[#81776F]">
              No se activaron reglas específicas para esta hipótesis.
            </p>
          )}
        </div>

        <div className="mt-6 border-t border-[#5A3A30] pt-5">
          <p className="text-xs font-bold text-[#5A3433]">
            Fuentes por síntoma
          </p>

          {hypothesis.fuentes_por_sintoma.length > 0 ? (
            <div className="mt-3 space-y-2">
              {hypothesis.fuentes_por_sintoma.map((item) => (
                <div key={item.sintoma} className="text-xs">
                  <span className="font-semibold">{item.sintoma}: </span>
                  <span className="text-[#81776F]">
                    {item.fuentes.map((source) => source.referencia).join(", ") ||
                      "Sin fuente registrada"}
                  </span>
                </div>
              ))}
            </div>
          ) : (
            <p className="mt-2 text-xs text-[#81776F]">
              No hay fuentes adicionales registradas.
            </p>
          )}
        </div>
      </article>
    );
  }

  return (
    <div className="min-h-screen bg-[#F3EFE8] text-white">
      <aside className="fixed inset-y-0 left-0 z-30 hidden w-[250px] flex-col bg-[#5A3433] text-white lg:flex">
        <div className="flex h-[85px] items-center gap-3 border-b border-white/10 px-7">
          <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-[#A66B64] text-[#5A3433]">
            <PawPrint size={22} />
          </div>

          <div>
            <h1 className="font-heading text-xl font-extrabold tracking-tight">
              VetIA
            </h1>
            <p className="text-[9px] uppercase tracking-[.22em] text-white/50">
              Canine diagnostic system
            </p>
          </div>
        </div>

        <div className="px-5 pt-9">
          <p className="mb-4 px-3 text-[9px] font-bold uppercase tracking-[.2em] text-white/40">
            Plataforma
          </p>

          <button
            onClick={() => setSection("diagnostico")}
            className={`mb-2 flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-semibold transition ${
              section === "diagnostico"
                ? "bg-[#A66B64] text-[#5A3433]"
                : "text-white/70 hover:bg-white/10"
            }`}
          >
            <Stethoscope size={18} />
            Diagnóstico
          </button>

          <button
            onClick={() => setSection("conocimiento")}
            className={`flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-semibold transition ${
              section === "conocimiento"
                ? "bg-[#A66B64] text-[#5A3433]"
                : "text-white/70 hover:bg-white/10"
            }`}
          >
            <Database size={18} />
            Base de conocimiento
          </button>
        </div>

        <div className="mt-auto border-t border-white/10 p-6">
          <div className="flex items-center gap-3">
            <div className="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10">
              <ShieldCheck size={18} />
            </div>

            <div>
              <p className="text-xs font-bold">Sistema VetIA</p>
              <p className="mt-1 text-[10px] text-white/40">
                Motor de inferencia Prolog
              </p>
            </div>
          </div>
        </div>
      </aside>

      <div className="lg:pl-[250px]">
        <header className="sticky top-0 z-20 flex h-[76px] items-center justify-between border-b border-[#5A3A30] bg-[#F3EFE8]/95 px-5 backdrop-blur sm:px-9">
          <div>
            <p className="text-[9px] font-bold uppercase tracking-[.2em] text-[#81776F]">
              VETIA / SISTEMA CLÍNICO
            </p>

            <h2 className="mt-1 font-heading text-sm font-bold">
              {section === "diagnostico"
                ? "Evaluación diagnóstica"
                : "Base de conocimiento"}
            </h2>
          </div>

          <div className="flex items-center gap-2 rounded-full border border-[#5A3A30] bg-[#FAF8F4] px-3 py-2">
            <span
              className={`h-2 w-2 rounded-full ${
                backendStatus === "Prolog conectado"
                  ? "bg-green-500"
                  : "bg-amber-500"
              }`}
            />

            <span className="text-[10px] font-bold text-[#81776F]">
              {backendStatus}
            </span>

            <button
              onClick={loadData}
              title="Actualizar conexión y catálogos"
              className="ml-1 text-[#81776F] hover:text-[#5A3433]"
            >
              <RefreshCw size={13} />
            </button>
          </div>
        </header>

        <main className="mx-auto max-w-[1500px] p-5 sm:p-9">
          {loading ? (
            <div className="flex min-h-[400px] flex-col items-center justify-center gap-4">
              <LoaderCircle
                className="animate-spin text-[#5A3433]"
                size={35}
              />
              <p className="text-sm text-[#81776F]">
                Conectando con el sistema VetIA...
              </p>
            </div>
          ) : error && symptoms.length === 0 ? (
            <div className="rounded-2xl border border-red-200 bg-[#FAF8F4] p-8">
              <AlertCircle className="mb-4 text-red-500" size={30} />

              <h2 className="font-heading text-lg font-bold">
                No se pudo cargar VetIA
              </h2>

              <p className="mt-2 text-sm text-[#81776F]">{error}</p>

              <button
                onClick={loadData}
                className="mt-5 rounded-xl bg-[#5A3433] px-5 py-3 text-xs font-bold text-white"
              >
                Reintentar conexión
              </button>
            </div>
          ) : section === "diagnostico" ? (
            <>
              <div className="mb-9">
                <div className="flex items-center gap-2 text-xs font-semibold text-[#81776F]">
                  <HeartPulse size={16} />
                  HERRAMIENTA DE APOYO CLÍNICO CANINO
                </div>

                <h1 className="mt-4 font-heading text-3xl font-extrabold tracking-tight sm:text-4xl">
                  Evaluación de{" "}
                  <span className="text-[#A66B64]">síntomas.</span>
                </h1>

                <p className="mt-3 max-w-2xl text-sm leading-6 text-[#81776F]">
                  Registra los signos clínicos observados en el paciente.
                  VetIA evaluará las coincidencias con las enfermedades
                  registradas en su base de conocimiento.
                </p>
              </div>

              <div className="grid grid-cols-1 items-start gap-7 xl:grid-cols-[minmax(0,1fr)_340px]">
                <section className="min-w-0">
                  <div className="mb-5 flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <p className="text-[9px] font-bold uppercase tracking-[.2em] text-[#81776F]">
                        EVALUACIÓN CLÍNICA
                      </p>

                      <h2 className="mt-1 font-heading text-lg font-bold">
                        Selección de síntomas
                      </h2>
                    </div>

                    <span className="rounded-full bg-[#FAF8F4] px-3 py-2 text-[10px] font-bold text-[#81776F]">
                      {presentSymptoms.length} presentes ·{" "}
                      {absentSymptoms.length} ausentes
                    </span>
                  </div>

                  <div className="space-y-4">
                    {systems.map((system) => {
                      const systemSymptoms = symptoms.filter(
                        (symptom) => symptom.sistema === system
                      );

                      return (
                        <div
                          key={system}
                          className="overflow-hidden rounded-2xl border border-[#5A3A30] bg-[#FAF8F4]"
                        >
                          <div className="border-b border-[#5A3A30] px-5 py-4">
                            <h3 className="text-xs font-bold uppercase tracking-wider text-[#5A3433]">
                              {system.replaceAll("_", " ")}
                            </h3>

                            <p className="mt-1 text-[10px] text-[#81776F]">
                              {systemSymptoms.length} síntomas registrados
                            </p>
                          </div>

                          <div className="divide-y divide-[#5A3A30]">
                            {systemSymptoms.map((symptom) => {
                              const isPresent = presentSymptoms.includes(
                                symptom.id
                              );

                              const isAbsent = absentSymptoms.includes(
                                symptom.id
                              );

                              return (
                                <div
                                  key={symptom.id}
                                  className="flex flex-col justify-between gap-3 px-5 py-4 sm:flex-row sm:items-center"
                                >
                                  <div>
                                    <p className="text-sm font-semibold">
                                      {symptom.nombre}
                                    </p>

                                    <span className="mt-1 inline-block text-[9px] uppercase tracking-wider text-[#81776F]">
                                      {symptom.categoria}
                                    </span>
                                  </div>

                                  <div className="flex shrink-0 gap-2">
                                    <button
                                      onClick={() =>
                                        toggleSymptom(symptom.id, "present")
                                      }
                                      aria-pressed={isPresent}
                                      className={`rounded-lg px-3 py-2 text-[10px] font-bold transition ${
                                        isPresent
                                          ? "bg-[#5A3433] text-white"
                                          : "bg-[#FAF8F4] text-[#81776F] hover:bg-[#5A3A30]"
                                      }`}
                                    >
                                      Presente
                                    </button>

                                    <button
                                      onClick={() =>
                                        toggleSymptom(symptom.id, "absent")
                                      }
                                      aria-pressed={isAbsent}
                                      className={`rounded-lg px-3 py-2 text-[10px] font-bold transition ${
                                        isAbsent
                                          ? "bg-[#5A3433] text-red-700"
                                          : "bg-[#FAF8F4] text-[#81776F] hover:bg-[#5A3A30]"
                                      }`}
                                    >
                                      Ausente
                                    </button>
                                  </div>
                                </div>
                              );
                            })}
                          </div>
                        </div>
                      );
                    })}
                  </div>

                  <div className="mt-6 flex flex-wrap gap-3">
                    <button
                      onClick={handleDiagnosis}
                      disabled={analyzing}
                      className="inline-flex items-center gap-2 rounded-xl bg-[#5A3433] px-6 py-4 text-xs font-bold text-white transition hover:bg-[#5A3433] disabled:opacity-50"
                    >
                      {analyzing ? (
                        <LoaderCircle className="animate-spin" size={16} />
                      ) : (
                        <Activity size={16} />
                      )}

                      {analyzing
                        ? "Analizando..."
                        : "Ejecutar evaluación"}
                    </button>

                    <button
                      onClick={resetDiagnosis}
                      className="inline-flex items-center gap-2 rounded-xl border border-[#5A3A30] bg-[#FAF8F4] px-5 py-4 text-xs font-bold text-[#81776F] hover:bg-[#FAF8F4]"
                    >
                      <RefreshCw size={15} />
                      Limpiar evaluación
                    </button>
                  </div>

                  {error && (
                    <p className="mt-4 rounded-xl bg-red-50 p-4 text-xs text-red-700">
                      {error}
                    </p>
                  )}
                </section>

                <aside className="order-first space-y-5 xl:order-none">
                  <div className="rounded-2xl bg-[#5A3433] p-6 text-white">
                    <div className="flex items-center gap-2 text-[#A66B64]">
                      <Activity size={17} />
                      <span className="text-[9px] font-bold uppercase tracking-[.2em]">
                        Estado de evaluación
                      </span>
                    </div>

                    <h3 className="mt-6 font-heading text-2xl font-extrabold">
                      {result ? "Evaluación completada" : "En espera"}
                    </h3>

                    <p className="mt-2 text-xs leading-5 text-white/60">
                      {result
                        ? "El motor de inferencia ha procesado los síntomas registrados."
                        : "Selecciona los signos clínicos para iniciar el análisis."}
                    </p>

                    <div className="mt-6 grid grid-cols-2 gap-3">
                      <div className="rounded-xl bg-white/10 p-4">
                        <p className="text-[9px] text-white/50">Presentes</p>
                        <p className="mt-1 text-2xl font-bold">
                          {presentSymptoms.length}
                        </p>
                      </div>

                      <div className="rounded-xl bg-white/10 p-4">
                        <p className="text-[9px] text-white/50">Ausentes</p>
                        <p className="mt-1 text-2xl font-bold">
                          {absentSymptoms.length}
                        </p>
                      </div>
                    </div>
                  </div>

                  <div className="rounded-2xl border border-[#5A3A30] bg-[#FAF8F4] p-6">
                    <div className="flex items-center gap-2">
                      <Database size={17} className="text-[#5A3433]" />
                      <h3 className="text-sm font-bold">
                        Base de conocimiento
                      </h3>
                    </div>

                    <div className="mt-5 space-y-4">
                      <div className="flex items-center justify-between">
                        <span className="text-xs text-[#81776F]">
                          Enfermedades
                        </span>

                        <span className="font-heading text-lg font-bold">
                          {diseases.length}
                        </span>
                      </div>

                      <div className="h-px bg-[#5A3A30]" />

                      <div className="flex items-center justify-between">
                        <span className="text-xs text-[#81776F]">
                          Síntomas
                        </span>

                        <span className="font-heading text-lg font-bold">
                          {symptoms.length}
                        </span>
                      </div>
                    </div>
                  </div>

                  <div className="rounded-2xl border border-[#5A3A30] bg-[#FAF8F4] p-5">
                    <div className="flex items-center gap-2 text-[#5A3433]">
                      <ShieldCheck size={17} />
                      <span className="text-xs font-bold">
                        Apoyo a la decisión clínica
                      </span>
                    </div>

                    <p className="mt-3 text-[10px] leading-5 text-[#81776F]">
                      Los resultados representan hipótesis basadas en
                      coincidencias de signos registrados. No constituyen
                      probabilidades ni sustituyen la valoración veterinaria.
                    </p>
                  </div>
                </aside>
              </div>

              {result && (
                <section className="mt-10">
                  <div className="mb-5">
                    <p className="text-[9px] font-bold uppercase tracking-[.2em] text-[#81776F]">
                      MOTOR DE INFERENCIA PROLOG
                    </p>

                    <h2 className="mt-1 font-heading text-xl font-bold">
                      Resultados de la evaluación
                    </h2>

                    <p className="mt-2 text-xs text-[#81776F]">
                      {result.nota}
                    </p>
                  </div>

                  <div className="mb-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
                    <div className="rounded-2xl border border-[#5A3A30] bg-[#FAF8F4] p-5">
                      <p className="text-xs text-[#81776F]">Estado</p>
                      <p className="mt-2 font-bold">{result.estado}</p>
                    </div>

                    <div className="rounded-2xl border border-[#5A3A30] bg-[#FAF8F4] p-5">
                      <p className="text-xs text-[#81776F]">
                        Hipótesis encontradas
                      </p>
                      <p className="mt-2 font-heading text-2xl font-bold">
                        {result.total_hipotesis}
                      </p>
                    </div>

                    <div className="rounded-2xl border border-[#5A3A30] bg-[#FAF8F4] p-5">
                      <p className="text-xs text-[#81776F]">
                        Empates en el límite del top 3
                      </p>
                      <p className="mt-2 font-heading text-2xl font-bold">
                        {result.empate_en_limite_top_3}
                      </p>
                    </div>
                  </div>

                  {result.hipotesis.length > 0 ? (
                    result.hipotesis.map((hypothesis, index) => (
                      <HypothesisCard
                        key={hypothesis.enfermedad.id}
                        hypothesis={hypothesis}
                        index={index}
                      />
                    ))
                  ) : (
                    <div className="rounded-2xl border border-[#5A3A30] bg-[#FAF8F4] p-7">
                      <CheckCircle2
                        className="mb-3 text-[#5A3433]"
                        size={25}
                      />

                      <h3 className="font-heading font-bold">
                        Sin coincidencias registradas
                      </h3>

                      <p className="mt-2 text-xs text-[#81776F]">
                        El motor no encontró hipótesis con los signos
                        proporcionados.
                      </p>
                    </div>
                  )}

                  {result.reglas_activadas_fuera_del_top_3.length > 0 && (
                    <div className="mt-5 rounded-2xl border border-[#5A3A30] bg-[#FAF8F4] p-6">
                      <p className="text-xs font-bold">
                        Enfermedades con reglas activadas fuera del top 3
                      </p>

                      <div className="mt-3 flex flex-wrap gap-2">
                        {result.reglas_activadas_fuera_del_top_3.map(
                          (disease) => (
                            <span
                              key={disease}
                              className="rounded-lg bg-[#5A3433] px-3 py-2 text-[10px] text-[#5A3433]"
                            >
                              {disease}
                            </span>
                          )
                        )}
                      </div>
                    </div>
                  )}
                </section>
              )}
            </>
          ) : (
            <section>
              <div className="mb-8">
                <p className="text-[9px] font-bold uppercase tracking-[.2em] text-[#81776F]">
                  CONOCIMIENTO VETERINARIO
                </p>

                <h1 className="mt-3 font-heading text-3xl font-extrabold">
                  Enfermedades registradas.
                </h1>

                <p className="mt-3 text-sm text-[#81776F]">
                  Información obtenida directamente de la API de VetIA.
                </p>
              </div>

              <div className="mb-5 flex items-center gap-3 rounded-xl border border-[#5A3A30] bg-[#FAF8F4] px-4 py-3">
                <Search size={17} className="text-[#81776F]" />

                <input
                  value={search}
                  onChange={(event) => setSearch(event.target.value)}
                  placeholder="Buscar enfermedad..."
                  className="w-full bg-transparent text-sm outline-none"
                />
              </div>

              <div className="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                {filteredDiseases.map((disease) => (
                  <article
                    key={disease.id}
                    className="rounded-2xl border border-[#5A3A30] bg-[#FAF8F4] p-6 transition hover:border-[#5A3433]"
                  >
                    <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-[#5A3433] text-[#5A3433]">
                      <HeartPulse size={19} />
                    </div>

                    <h3 className="mt-5 font-heading text-base font-bold">
                      {disease.nombre}
                    </h3>

                    <p className="mt-2 text-xs text-[#81776F]">
                      Identificador: {disease.id}
                    </p>

                    <div className="mt-5 flex items-center gap-2 text-[10px] font-bold text-[#5A3433]">
                      Registro de conocimiento
                      <ChevronRight size={13} />
                    </div>
                  </article>
                ))}

                {filteredDiseases.length === 0 && (
                  <p className="text-sm text-[#81776F]">
                    No se encontraron enfermedades.
                  </p>
                )}
              </div>
            </section>
          )}
        </main>
      </div>
    </div>
  );
}